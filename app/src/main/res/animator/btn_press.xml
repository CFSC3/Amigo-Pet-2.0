<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado: Quando o botão está sendo pressionado (encolhe para 95% do tamanho) -->
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX"
                android:duration="100" android:valueTo="0.95" android:valueType="floatType"/>
            <objectAnimator android:propertyName="scaleY"
                android:duration="100" android:valueTo="0.95" android:valueType="floatType"/>
        </set>
    </item>

    <!-- Estado: Padrão / Quando solta (volta para 100% do tamanho) -->
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX"
                android:duration="100" android:valueTo="1.0" android:valueType="floatType"/>
            <objectAnimator android:propertyName="scaleY"
                android:duration="100" android:valueTo="1.0" android:valueType="floatType"/>
        </set>
    </item>
</selector>