<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnSalvarPet"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Foto do Pet -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imgAddFotoPet"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="32dp"
                android:src="@drawable/icon_pet_profile"
                app:civ_border_color="#F6A800"
                app:civ_border_width="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_menu_camera"
                app:tint="@color/colorTextPrimary"
                app:layout_constraintBottom_toBottomOf="@+id/imgAddFotoPet"
                app:layout_constraintEnd_toEndOf="@+id/imgAddFotoPet" />

            <!-- Campo: Nome do Pet -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutNomePet"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="32dp"
                android:hint="Nome do Pet"
                app:layout_constraintTop_toBottomOf="@+id/imgAddFotoPet">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editNomePet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Campo: Espécie (Menu Suspenso) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutEspecie"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:hint="Espécie"
                app:layout_constraintTop_toBottomOf="@+id/layoutNomePet">
                <AutoCompleteTextView
                    android:id="@+id/dropdownEspecie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Campo: Espécie  -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutEspecieOutro"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:hint="Qual espécie?"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/layoutEspecie">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editEspecieOutro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Campo: Raça -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRaca"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:hint="Raça"
                app:layout_constraintTop_toBottomOf="@+id/layoutEspecieOutro">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editRaca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Campo: Cor -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutCor"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:hint="Cor"
                app:layout_constraintTop_toBottomOf="@+id/layoutRaca">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Castração (RadioGroup) -->
            <TextView
                android:id="@+id/textCastradoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="24dp"
                android:text="O pet é castrado?"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutCor" />

            <RadioGroup
                android:id="@+id/radioGroupCastrado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textCastradoTitle">

                <RadioButton
                    android:id="@+id/radioSim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sim" />

                <RadioButton
                    android:id="@+id/radioNao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Não" />
            </RadioGroup>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSalvarPet"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="Salvar Pet"
        android:textColor="@color/branco"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#F6A800"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>