<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Toolbar da Thread -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarThread"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Postagem"
        app:titleCentered="true"
        app:titleTextColor="@color/colorTextPrimary">

        <ImageButton
            android:id="@+id/btnExcluirPostagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/icon_delete"
            app:tint="#D32F2F" />

        <ImageButton
            android:id="@+id/btnEditarPostagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_outline_create_24"
            app:tint="#F6A800" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Scroll principal englobando a postagem e a lista -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutDigitarComentarioThread"
        app:layout_constraintTop_toBottomOf="@+id/toolbarThread">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Incluindo o Card da Postagem Padrão -->
            <include
                android:id="@+id/cardPostagemThread"
                layout="@layout/postagem_detalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Lista de Comentários embutida -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerComentariosThread"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="16dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra de digitação fixa no rodapé -->
    <LinearLayout
        android:id="@+id/layoutDigitarComentarioThread"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/editComentarioThread"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Adicione um comentário..."
            android:padding="12dp"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnEnviarComentarioThread"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:padding="8dp"
            android:src="@drawable/ic_send_24"
            app:tint="@color/colorPrimary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>