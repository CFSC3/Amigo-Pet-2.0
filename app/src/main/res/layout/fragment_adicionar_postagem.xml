<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="16dp">

    <!-- CABEÇALHO DO AUTOR (Quem está postando) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgAvatarAutorPost"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:background="@color/colorDivider"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtUsernameAutorPost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@seu_username"
        android:textColor="@color/colorTextPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/imgAvatarAutorPost"
        app:layout_constraintStart_toEndOf="@+id/imgAvatarAutorPost"
        app:layout_constraintTop_toTopOf="@+id/imgAvatarAutorPost" />

    <!-- ÁREA DA MÍDIA (Foto/Vídeo) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEscolherMidia"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/colorSurface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/colorDivider"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgAvatarAutorPost">

        <!-- Imagem selecionada (Oculta por padrão) -->
        <ImageView
            android:id="@+id/imgMidiaSelecionada"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Placeholder (Estado Inicial) -->

        <!-- Ícone de Play Indicador -->
        <LinearLayout
            android:id="@+id/layoutPlaceholderAddMidia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_camera_alt_black_24dp"
                app:tint="#9E9E9E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Toque para adicionar Foto ou Vídeo"
                android:textColor="#9E9E9E"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iconePlayIndicador"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play_circle_filled_24"
            android:visibility="gone"
            app:tint="#CCFFFFFF" />

    </com.google.android.material.card.MaterialCardView>

    <!-- CAMPO DA LEGENDA (Preenche o espaço livre dinamicamente) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutLegenda"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:hint="O que seu pet aprontou hoje?"
        app:layout_constraintBottom_toTopOf="@+id/layoutBotoes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardEscolherMidia">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editLegendaPostagem"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top|start"
            android:inputType="textMultiLine" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- BOTÕES INFERIORES (Fixos no rodapé) -->
    <LinearLayout
        android:id="@+id/layoutBotoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarPostagem"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textColor="@color/colorTextPrimary"
            app:cornerRadius="12dp"
            app:strokeColor="#BDBDBD" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublicarPostagem"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Publicar"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>