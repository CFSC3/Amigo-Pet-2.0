<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Conta"
            android:textColor="#F6A800"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrocarSenhaConfig"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="start|center_vertical"
            android:text="Alterar Senha"
            android:textColor="@color/colorTextPrimary"
            app:backgroundTint="@color/colorSurface"
            app:cornerRadius="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="Informações"
            android:textColor="#F6A800"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSobreConfig"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="start|center_vertical"
            android:text="Sobre o App"
            android:textColor="@color/colorTextPrimary"
            app:backgroundTint="@color/colorSurface"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTermosConfig"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="2dp"
            android:gravity="start|center_vertical"
            android:text="Termos e Condições"
            android:textColor="@color/colorTextPrimary"
            app:backgroundTint="@color/colorSurface"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrivacidadeConfig"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="2dp"
            android:gravity="start|center_vertical"
            android:text="Política de Privacidade"
            android:textColor="@color/colorTextPrimary"
            app:backgroundTint="@color/colorSurface"
            app:cornerRadius="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="Zona de Perigo"
            android:textColor="#D32F2F"
            android:textStyle="bold" />

        <!-- Botão de Exclusão: Mantido com fundo vermelho claro -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExcluirConfig"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="start|center_vertical"
            android:text="Excluir Conta Definitivamente"
            android:textColor="#D32F2F"
            app:backgroundTint="#FFEBEE"
            app:cornerRadius="8dp" />

        <!-- Espaçamento extra para isolar o botão de Sair -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <!-- Botão de Sair: Centralizado, borda laranja e fundo branco -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSairConfig"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="Sair da Conta"
            android:textColor="@color/ttt"
            app:backgroundTint="@color/colorSurface"
            app:strokeColor="@color/ttt"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp" />
    </LinearLayout>
</ScrollView>