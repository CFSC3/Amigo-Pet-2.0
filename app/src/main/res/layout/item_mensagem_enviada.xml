<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="64dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_balao_enviado"
        android:orientation="vertical"
        android:padding="10dp">

        <FrameLayout
            android:id="@+id/layoutMidiaEnviada"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:visibility="gone">

            <VideoView
                android:id="@+id/videoMidiaEnviada"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imageMidiaEnviada"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/iconePlayEnviado"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_play"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/textMensagemEnviada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/branco"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textHoraEnviada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:textColor="@color/colorSurface"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>