<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Modo de Exibição"
            android:textColor="#F6A800"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupTema"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/radioTemaSistema"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Padrão do Sistema"
                android:textColor="@color/colorTextPrimary" />

            <RadioButton
                android:id="@+id/radioTemaClaro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modo Claro"
                android:textColor="@color/colorTextPrimary" />

            <RadioButton
                android:id="@+id/radioTemaEscuro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modo Escuro"
                android:textColor="@color/colorTextPrimary" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Plano de Fundo das Conversas"
            android:textColor="#F6A800"
            android:textStyle="bold" />

        <!-- Pré-visualização ajustada para proporção vertical (estilo tela de chat) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="180dp"
            android:layout_height="320dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/colorDivider"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/imgPreviewFundoChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/colorSurface"
                android:scaleType="centerCrop" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEscolherFundoChat"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Escolher Imagem na Galeria"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemoverFundoChat"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:text="Restaurar Fundo Padrão"
            android:textColor="#D32F2F"
            app:backgroundTint="@color/colorSurface"
            app:cornerRadius="8dp"
            app:strokeColor="#D32F2F"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>