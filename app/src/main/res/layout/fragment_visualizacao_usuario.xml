<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Capa do Usuário -->
            <ImageView
                android:id="@+id/imageCapaVisita"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:src="@drawable/padrao"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Foto de Perfil do Usuário -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imagePerfilVisita"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="130dp"
                android:src="@drawable/ic_avatar_pet"
                app:civ_border_color="#FFFFFF"
                app:civ_border_width="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Nome e Bio -->
        <TextView
            android:id="@+id/textNomeVisita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Carregando..."
            android:textColor="@color/colorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textBioVisita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Carregando biografia..."
            android:textColor="@color/colorTextPrimary"
            android:textSize="14sp" />

        <!-- Botões de Ação: Chat e Favorito -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <!-- Botão de Chat -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciarChat"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Enviar Mensagem"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:icon="@drawable/ic_chat"
                app:iconSize="24dp"
                app:iconPadding="8dp"
                app:cornerRadius="24dp"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@color/colorSurface"/>

        </LinearLayout>

        <!-- Carrossel de Pets -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPetsVisita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupFeedVisita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_gravity="center_horizontal"
            app:checkedButton="@+id/btnAbaPostagensVisita"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbaPostagensVisita"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mídias" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbaPublicacoesVisita"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Publicações" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Feed do Usuário -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerFeedVisita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="24dp" />

    </LinearLayout>
</ScrollView>