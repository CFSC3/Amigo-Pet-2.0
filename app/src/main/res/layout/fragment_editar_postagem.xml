<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <!-- Topo Customizado Clean -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="@color/colorSurface"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btnVoltarEditar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="?attr/homeAsUpIndicator"
            app:tint="@color/colorTextPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Editar Postagem"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginStart="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvarEdicao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salvar"
            android:textColor="@color/branco"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="20dp"
            android:minHeight="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Container da mídia com bordas arredondadas e fundo cinza claro -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMidiaAtual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/colorDivider"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="250dp">

                    <!-- Reprodutor de Vídeo (Oculto por padrão) -->
                    <VideoView
                        android:id="@+id/videoMidiaAtual"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/imgMidiaAtual"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter" />

                    <!-- Ícone de Play centralizado -->
                    <ImageView
                        android:id="@+id/iconePlayVideoAtual"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play_circle_filled_24"
                        android:visibility="gone"
                        app:tint="#CCFFFFFF" />

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Caixa de texto invisível (sem bordas/fundo) -->
            <EditText
                android:id="@+id/editTextoPostagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="5"
                android:gravity="top|start"
                android:hint="Escreva sua legenda..."
                android:background="@null"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>